<header class="topbar">
	<button class="menu-btn" type="button" aria-label={t.openMenu} aria-controls="sidebar" aria-expanded="false"><svg class="i"><use href="#menu"/></svg></button>
	<a class="tb-logo" href="/admin">{logo ? <img src={logo} alt={kit.brand.name}> : <span class="brand-text">{kit.brand.name}</span>}</a>
	<a class="tb-site" href="/" {...ext} aria-label={t.viewSite} title={t.viewSite}><svg class="i"><use href="#out"/></svg></a>
</header>

<button class="backdrop" type="button" tabindex="-1" aria-label={t.closeMenu}></button>

<aside class="sidebar" id="sidebar">
	<a class="side-head" href="/admin">{logo ? <img src={logo} alt={kit.brand.name} width="150"> : <span class="brand-text">{kit.brand.name}</span>}<small>{t.studio}</small></a>
	<a class="side-site" href="/" {...ext} aria-label={t.viewSite} title={t.viewSite}><svg class="i"><use href="#out"/></svg></a>
	<nav class="side-nav" aria-label={t.mainMenu}>
		<a class="nav-link" aria-current={current === "oversikt" ? "page" : undefined} href="/admin"><svg class="ph"><use href="#m-dash"/></svg>{t.overview}</a>
		{(has("artikler") || extra.some((c) => has(c.tab)) || has("sider") || has("medier")) && <div class="group-label">{t.content}</div>}
		{has("artikler") && <a class="nav-link" href={`${E}/content/${kit.collections.articles.slug}`}><svg class="ph"><use href="#m-doc"/></svg>{t.articles}</a>}
		{extra.map((c) => has(c.tab) && <a class="nav-link" href={`${E}/content/${c.slug}`}><svg class="ph"><use href={`#${ICONS[c.icon ?? "doc"] ?? "m-doc"}`}/></svg>{extraName(c)}</a>)}
		{has("sider") && <a class="nav-link" href={`${E}/content/${kit.collections.pages.slug}`}><svg class="ph"><use href="#m-pages"/></svg>{t.pages}</a>}
		{has("medier") && <a class="nav-link" href={`${E}/media`}><svg class="ph"><use href="#m-media"/></svg>{t.media}</a>}
		{adminGroup && <div class="group-label">{t.administration}</div>}
		{has("brukere") && <a class="nav-link" href={`${E}/users`}><svg class="ph"><use href="#m-users"/></svg>{t.users}</a>}
		{has("innstillinger") && <a class="nav-link" href={`${E}/settings`}><svg class="ph"><use href="#m-gear"/></svg>{t.settings}</a>}
		{has("vibeinnstillinger") && <a class="nav-link" href={`${E}/plugins/vibe-editor/`}><svg class="ph" viewBox="0 0 256 256"><path d="M128 32l22 74 74 22-74 22-22 74-22-74-74-22 74-22z" fill="none" stroke="currentColor" stroke-width="16" stroke-linejoin="round"/></svg>Vibe Editor</a>}
		{has("tilganger") && <a class="nav-link" aria-current={current === "tilganger" ? "page" : undefined} href="/admin/tilganger"><svg class="ph"><use href="#m-key"/></svg>{t.tilganger}</a>}
		{has("tilganger") && <a class="nav-link" href={`${E}/plugins-manager`}><svg class="ph" viewBox="0 0 256 256"><rect x="40" y="40" width="72" height="72" rx="8" fill="none" stroke="currentColor" stroke-width="16"/><rect x="144" y="40" width="72" height="72" rx="8" fill="none" stroke="currentColor" stroke-width="16"/><rect x="40" y="144" width="72" height="72" rx="8" fill="none" stroke="currentColor" stroke-width="16"/><path d="M180 140v80M140 180h80" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round"/></svg>{t.plugins}</a>}
	</nav>
	<details class="side-user">
		<summary><span class="av">{initials}</span><span class="uname"><strong>{name}</strong><small>{roleLabel}</small></span></summary>
		<div class="menu-pop">
			<div class="who"><strong>{name}</strong><small>{roleLabel} · {user.email}</small></div>
			{help && <button data-open="help"><svg class="i"><use href="#help"/></svg>{t.help}</button>}
			<a class="menu-item" href={`${E}/settings/security`}><svg class="i"><use href="#lock"/></svg>{t.security}</a>
			{viewAs && <button data-exit-viewas><svg class="i"><use href="#eye"/></svg>{t.exitViewAs}</button>}
			<button id="logout-btn"><svg class="i"><use href="#logout"/></svg>{t.logout}</button>
		</div>
	</details>
</aside>

{viewAs && <script is:inline>document.body.classList.add("has-viewas")</script>}
{viewAs && <div class="viewas-bar" role="status">{t.viewingAs.replace("{role}", viewAs)}<button type="button" data-exit-viewas>{t.exitViewAs}</button></div>}

<script is:inline>
(() => {
	const userMenu = document.querySelector("details.side-user");
	document.addEventListener("click", (e) => { if (userMenu.open && !userMenu.contains(e.target)) userMenu.open = false; });
	const menu = document.querySelector(".menu-btn"), sidebar = document.getElementById("sidebar"), backdrop = document.querySelector(".backdrop");
	const toggle = (open) => {
		const was = sidebar.classList.contains("open");
		sidebar.classList.toggle("open", open);
		backdrop.classList.toggle("show", open);
		document.documentElement.classList.toggle("menu-open", open);
		menu.setAttribute("aria-expanded", String(open));
		if (open) sidebar.querySelector("a[aria-current], .nav-link")?.focus({ preventScroll: true });
		else if (was) menu.focus({ preventScroll: true });
	};
	menu.addEventListener("click", () => toggle(!sidebar.classList.contains("open")));
	backdrop.addEventListener("click", () => toggle(false));
	// Bredere skjerm (f.eks. telefonen snus): menyen står fast, så lukk mobilmenyen
	matchMedia("(min-width: 769px)").addEventListener("change", (e) => e.matches && toggle(false));
	document.addEventListener("keydown", (e) => { if (e.key === "Escape") { if (sidebar.classList.contains("open")) toggle(false); userMenu.open = false; } });
	document.querySelectorAll("[data-open=help]").forEach((b) => b.addEventListener("click", () => (userMenu.open = false)));
	document.querySelectorAll("[data-exit-viewas]").forEach((b) => b.addEventListener("click", () =>
		fetch("/api/tilganger", { method: "PUT", headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" }, credentials: "same-origin", body: JSON.stringify({ viewAs: null }) })
			.then(() => location.assign("/admin"))));
	document.getElementById("logout-btn").addEventListener("click", async () => {
		await fetch("/_emdash/api/auth/logout", { method: "POST", headers: { "X-EmDash-Request": "1" }, credentials: "same-origin" });
		location.href = "/_emdash/admin/login?redirect=%2Fadmin";
	});
})();
</script>
