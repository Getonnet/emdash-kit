---
// Menyen på kontrollpanelet (/admin og /admin/tilganger). Samme punkter og utseende som EmDash-menyen,
// filtrert etter fanene rollen har (src/roller.ts). Tilganger og Utvidelser vises bare for super admin.
// Brukeren nederst åpner Hjelp (der siden har en hjelp-dialog), Avslutt «Se som» og Logg ut.
import type { Access, Tab } from "../roller";
import { kit, type ExtraCollection } from "../config";

interface Props {
	t: any;
	user: { name?: string | null; email: string; role: number };
	access: Access;
	current: "oversikt" | "tilganger";
	help?: boolean;
}

const { t, user, access, current, help = false } = Astro.props;
const E = "/_emdash/admin";
const logo = kit.brand.logo;
const has = (tab: Tab) => access.tabs.includes(tab);
const name = user.name || user.email;
const initials = name.split(/[\s@.]/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join("");
const roleLabel = t.roleNames[access.role];
const viewAs = access.viewAs ? t.roleNames[access.viewAs] : null;
const ext = { target: "_blank", rel: "noopener" };
const extra = (kit.collections.extra ?? []) as ExtraCollection[];
const extraName = (c: ExtraCollection) => c[t.locale?.startsWith("en") ? "en" : "nb"].plural;
const ICONS: Record<string, string> = { doc: "m-doc", pages: "m-pages", media: "m-media", user: "m-user" };
const adminGroup = has("brukere") || has("innstillinger") || has("vibeinnstillinger") || has("tilganger");
---

<style is:inline>
/* Meny – samme mål og tekster som EmDash-menyen */
.sidebar{width:260px;position:fixed;inset:0 auto 0 0;background:var(--card);border-right:1px solid var(--line);display:flex;flex-direction:column;z-index:20}
/* stor logo med undertittel, luftige menypunkter og brukeren nederst (likt i EmDash-menyen) */
.side-head{display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:28px 20px 14px}
.side-head img{width:150px;height:auto;max-height:60px;object-fit:contain;object-position:left center}
.brand-text{font:600 20px/1.2 var(--serif);letter-spacing:-.01em;color:var(--ink)}
.side-head small{font-size:10px;font-weight:600;letter-spacing:.16em;color:var(--ek-label)}
.side-nav{flex:1;overflow:auto;padding:6px 14px 18px;display:flex;flex-direction:column;gap:1px}
.group-label{margin-top:12px;height:37px;display:flex;align-items:flex-end;padding:0 12px 8px;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--ek-label)}
.nav-link{display:flex;align-items:center;gap:11px;min-height:40px;padding:0 14px;border-radius:10px;font-size:13.5px;font-weight:500;color:var(--muted)}
.nav-link:hover{background:var(--paper)}.nav-link[aria-current]{background:var(--wash);color:var(--teal-ink);font-weight:600}
.nav-link svg{opacity:.4}.nav-link[aria-current] svg{opacity:1}
/* «Vis nettsted» som ikon til høyre for logoen (ingen toppbar, likt EmDash-sidene) */
.side-site{position:absolute;top:24px;right:14px;display:flex;padding:7px;border-radius:8px;color:var(--muted)}.side-site:hover{background:var(--paper);color:var(--ink)}.side-site svg{width:16px;height:16px}
/* Brukeren nederst: klikk åpner Hjelp, Avslutt «Se som» og Logg ut */
.side-user{position:relative;border-top:1px solid var(--line)}
.side-user summary{list-style:none;display:flex;align-items:center;gap:11px;padding:14px 20px;cursor:pointer;text-align:left}.side-user summary::-webkit-details-marker{display:none}.side-user summary:hover{background:var(--paper)}
.side-user .uname{min-width:0}
.side-user .av{display:grid;place-items:center;width:34px;height:34px;flex-shrink:0;border-radius:50%;background:var(--wash);color:var(--teal-ink);font:var(--ek-heading-weight) 16px/1 var(--serif)}
.side-user strong{display:block;font-size:13px;font-weight:600;line-height:1.3}.side-user small{display:block;font-size:11.5px;color:var(--muted)}
.shell{margin-left:260px}
/* Mobil: toppstripe med menyknapp, logo og «Vis nettsted» (som toppbaren EmDash har på mobil) */
.topbar{display:none}
.topbar .menu-btn{display:grid;place-items:center;width:44px;height:44px;margin-left:-6px;border-radius:10px}
.topbar .menu-btn:hover,.topbar .tb-site:hover{background:var(--paper)}
.topbar .tb-logo{display:flex;align-items:center;min-width:0;flex:1}.topbar .tb-logo img{height:24px;width:auto;max-width:150px;object-fit:contain}.topbar .tb-logo .brand-text{font-size:17px}
.topbar .tb-site{display:grid;place-items:center;width:44px;height:44px;margin-right:-6px;border-radius:10px;color:var(--muted)}.topbar .tb-site svg{width:18px;height:18px}
.menu-pop{position:absolute;left:12px;right:12px;bottom:calc(100% + 6px);min-width:230px;background:var(--card);border:1px solid var(--line);border-radius:12px;box-shadow:0 14px 40px color-mix(in srgb,var(--ek-shadow) 9%,transparent);padding:6px;z-index:30}
.menu-pop .who{white-space:normal;overflow-wrap:anywhere;padding:10px 12px 8px;border-bottom:1px solid var(--line);margin-bottom:6px}.menu-pop .who strong{display:block;font-size:13px}.menu-pop .who small{font-size:12px;color:var(--muted)}
.menu-pop button,.menu-pop .menu-item{width:100%;display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:8px;font-size:13px;text-align:left}.menu-pop button:hover,.menu-pop .menu-item:hover{background:var(--paper)}.menu-pop svg{width:16px;height:16px}
.backdrop{display:none}
/* «Se som»: stripe nederst så det er tydelig at man ser siden som en annen rolle */
.viewas-bar{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);z-index:60;display:flex;align-items:center;gap:12px;padding:10px 12px 10px 16px;background:var(--navy);color:var(--ek-dark-text);border-radius:30px;box-shadow:0 14px 40px color-mix(in srgb,var(--ek-shadow) 19%,transparent);font-size:13px;font-weight:500;white-space:nowrap}
.viewas-bar button{background:var(--teal);color:var(--ek-accent-text);border-radius:30px;padding:6px 12px;font-weight:600;font-size:12.5px;white-space:nowrap}
body.has-viewas .shell{padding-bottom:72px}
@media(max-width:768px){
.topbar{position:sticky;top:0;z-index:17;display:flex;align-items:center;gap:8px;height:56px;padding:0 12px;background:color-mix(in srgb,var(--card) 92%,transparent);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
/* Lukket meny: utenfor skjermen og utenfor tab-rekkefølgen */
.sidebar{width:min(300px,86vw);transform:translateX(-100%);visibility:hidden;transition:transform .22s ease,visibility 0s linear .22s;box-shadow:none}
.sidebar.open{transform:none;visibility:visible;transition:transform .22s ease;box-shadow:0 0 40px color-mix(in srgb,var(--ek-shadow) 18%,transparent)}
.side-site{display:none}
.nav-link{min-height:44px}
.side-user summary{padding:14px 20px calc(14px + env(safe-area-inset-bottom))}
.menu-pop button,.menu-pop .menu-item{padding:12px}
.backdrop.show{display:block;position:fixed;inset:0;background:color-mix(in srgb,var(--ek-shadow) 38%,transparent);z-index:19}
.shell{margin-left:0}
.viewas-bar{left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));transform:none;white-space:normal;justify-content:space-between;line-height:1.35}
.viewas-bar button{padding:9px 14px}
}
html.menu-open{overflow:hidden}
</style>

