{
  "name": "@getonnet/emdash-kit",
  "version": "1.6.0-beta.2",
  "description": "Felles EmDash-oppsett for GetOnNet-prosjekter: kontrollpanel, roller og tilganger, norsk admin, e-post, besøksteller og Vibe Editor, med prosjektets egne farger og navn.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./besok": "./src/besok-snippet.ts",
